POSTGRES_DB=node_effect
POSTGRES_USER=node_effect
POSTGRES_PASSWORD=node_effect
POSTGRES_PORT=5432
# The role the containerized API and worker connect as; `migrate` creates it
# with access to the application's tables only. The name is lowercase letters,
# digits and _, not starting with a digit or pg_.
APP_DATABASE_USER=node_effect_app
APP_DATABASE_PASSWORD=node_effect_app
# Used by native commands, which all connect as the owner: `pnpm db:migrate`
# needs it, and `pnpm dev:api` and `pnpm dev:worker` share it. Compose gives
# each container its own URL.
DATABASE_URL=postgresql://node_effect:node_effect@127.0.0.1:5432/node_effect
DATABASE_STATEMENT_TIMEOUT_MS=10000
API_HOST=127.0.0.1
API_PORT=8000
WORKER_POLL_INTERVAL_MS=5000
WORKER_PASS_TIMEOUT_MS=60000
# The lowest level the API, worker and migrate log: All, Trace, Debug, Info,
# Warn, Error, Fatal or None, spelled exactly so. Debug adds a line per worker
# pass; None and Fatal also silence failure reports.
LOG_LEVEL=Info

{
  // The TypeScript 7 extension runs the project's tsc, which `prepare` patches
  // into the Effect build that `pnpm typecheck` runs, so VS Code shows the same
  // errors as the check. These four are what `effect-tsgo setup --vscode`
  // writes.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/typescript/bin",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsdk.additionalLocations": ["./node_modules/typescript/bin"],

  // Oxlint as you type, and on save Oxfmt and then Oxlint's safe fixes, as in
  // .zed/settings.json.
  "oxc.fixKind": "safe_fix",
  "oxc.unusedDisableDirectives": "deny",
  "[typescript][javascript][json][jsonc][yaml][markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.format.oxc": "always",
      "source.fixAll.oxc": "always"
    }
  }
}

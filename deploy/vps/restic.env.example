# Template for /etc/uncross/restic.env (mode 0600, owned by root),
# read by the backup and verify-backup services. Any S3-compatible bucket works
# (Cloudflare R2, Backblaze B2, Wasabi, AWS S3); keep it with a different
# provider than the server. See README.md for a bucket the server cannot empty.
RESTIC_REPOSITORY=s3:https://<s3-endpoint>/<bucket>
# Backups cannot be restored without this password; keep it in the password
# manager.
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 expects `auto`; other providers expect their bucket's region.
AWS_DEFAULT_REGION=auto

# Dead man's switch URLs, such as Healthchecks.io or Better Stack checks, one
# per job. A job pings its URL when it succeeds, and <URL>/fail with its last
# error lines when it fails. Without a ping in time, the switch alerts too. A
# URL with a query string is refused. Optional, but without them nothing alerts.
#
# bin/backup, nightly: a period of 1 day and a grace of 2 hours.
HEARTBEAT_URL=
# bin/verify-backup, weekly: a period of 7 days and a grace of 6 hours.
VERIFY_HEARTBEAT_URL=

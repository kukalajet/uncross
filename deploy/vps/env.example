# Template for /opt/node-effect-template/.env (mode 0600, owned by deploy). Keep
# the master copy of every value in a password manager.

# Where the Release workflow publishes the image: ghcr.io/<owner>/<repository>,
# all lowercase.
APP_IMAGE_REPOSITORY=ghcr.io/your-github-owner/node-effect-template

POSTGRES_DB=node_effect
POSTGRES_USER=node_effect
# Generate with `openssl rand -hex 32`; hex keeps the database URL valid.
POSTGRES_PASSWORD=
# The role the API and worker connect as, which can only read and write the
# application's tables. `migrate` creates it and sets this password on every
# release. Generate the password like POSTGRES_PASSWORD. The name is lowercase
# letters, digits and _, not starting with a digit or pg_, and no role that
# exists already for something else (see README.md before renaming it).
APP_DATABASE_USER=node_effect_app
APP_DATABASE_PASSWORD=
DATABASE_STATEMENT_TIMEOUT_MS=10000
WORKER_POLL_INTERVAL_MS=5000
WORKER_PASS_TIMEOUT_MS=60000
# The lowest level the API, worker and migrate log: All, Trace, Debug, Info,
# Warn, Error, Fatal or None, spelled exactly so. Debug adds a line per worker
# pass; None and Fatal also silence failure reports.
LOG_LEVEL=Info

# The token from the Cloudflare Tunnel's install command.
CLOUDFLARE_TUNNEL_TOKEN=

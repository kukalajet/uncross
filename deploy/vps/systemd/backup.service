[Unit]
Description=Back up the uncross PostgreSQL database
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/uncross/restic.env
# The service has no HOME, so restic needs its cache directory named; without a
# cache, every run downloads the repository index again.
CacheDirectory=uncross-restic
CacheDirectoryMode=0700
Environment=RESTIC_CACHE_DIR=/var/cache/uncross-restic
# A oneshot service has no start timeout by default, so a hung backup would run
# forever and hold back the next nights' runs. Past this, systemd stops it and
# bin/backup reports the failure. Raise it if a backup legitimately takes longer.
TimeoutStartSec=3h
ExecStart=/opt/uncross/bin/backup

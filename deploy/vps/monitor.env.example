# Template for /etc/uncross/monitor.env (mode 0600, owned by root),
# read by the monitor service every 5 minutes. It is kept apart from restic.env,
# so the monitor never sees the backup credentials.

# Dead man's switch URL, such as a Healthchecks.io or Better Stack check, with a
# period of 5 minutes and a grace of 15, longer than a release, which the
# monitor does not check. Pinged when every check passes, and at <URL>/fail with
# one line per problem otherwise. A URL with a query string is refused.
MONITOR_HEARTBEAT_URL=
# Alert when a filesystem holding / or Docker's data is fuller than this, in
# percent.
MONITOR_DISK_PERCENT=80
# Alert when more memory than this is in use, in percent, counting
# MemAvailable as free.
MONITOR_MEMORY_PERCENT=90
